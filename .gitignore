# ==========================================
# IMD-DAMU Weather Downscaling .gitignore
# ==========================================

# 1. Python Environment & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# 2. Node & Frontend Dependencies
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

# 3. Large Raw GIS & Remote Sensing Datasets (>50MB / S3 sync files)
data/dem/*.tif
data/dem/*.tiff
data/landcover/*.tif
data/gridded/*.nc
data/gridded/*.grd
data/boundaries/nwic_maharashtra/
data/boundaries/*.zip
data/boundaries/*.tar.gz
data/boundaries/*.parquet

# 4. Large Serialized ML Models & Caches
data/models/*.pkl
data/models/*.joblib
data/models/*.bin
*.onnx

# 5. OS & IDE Specific
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# 6. Logs, Testing & Diagnostic Outputs
*.log
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.system_generated/
scratch/
